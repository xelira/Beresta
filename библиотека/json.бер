// JSON поверх словарей и строк. Плоские объекты: ключ → строковое значение.
// Вложенные объекты и массивы при разборе пропускаются.

дело дж_пропуск(текст: строка, позиция: указатель число) -> ничто {
    доколе по позиция < длина(текст) {
        слово знак: строка = часть(текст, по позиция, 1);
        ежели знак == " " или знак == "\n" или знак == "\r" или знак == "\t" {
            по позиция = по позиция + 1;
        } инако {
            прервать;
        }
    }
}

дело дж_читать_строку(текст: строка, позиция: указатель число) -> строка {
    слово размер: число = длина(текст);
    слово результат: строка = "";

    по позиция = по позиция + 1;

    доколе по позиция < размер {
        слово знак: строка = часть(текст, по позиция, 1);

        ежели знак == "\"" {
            по позиция = по позиция + 1;
            вернуть результат;
        }

        ежели знак == "\\" {
            слово следующий: строка = часть(текст, по позиция + 1, 1);
            ежели следующий == "n" {
                результат += "\n";
            } инако ежели следующий == "t" {
                результат += "\t";
            } инако ежели следующий == "r" {
                результат += "\r";
            } инако {
                результат += следующий;
            }
            по позиция = по позиция + 2;
        } инако {
            результат += знак;
            по позиция = по позиция + 1;
        }
    }

    вернуть результат;
}

дело дж_пропустить_вложенное(текст: строка, позиция: указатель число) -> ничто {
    слово открывающий: строка = часть(текст, по позиция, 1);
    слово закрывающий: строка = "}";
    ежели открывающий == "[" {
        закрывающий = "]";
    }

    слово глубина: число = 0;

    доколе по позиция < длина(текст) {
        слово знак: строка = часть(текст, по позиция, 1);

        ежели знак == "\"" {
            дж_читать_строку(текст, позиция);
            продолжить;
        }

        ежели знак == открывающий {
            глубина += 1;
        } инако ежели знак == закрывающий {
            глубина -= 1;
            по позиция = по позиция + 1;
            ежели глубина <= 0 {
                вернуть;
            }
            продолжить;
        }

        по позиция = по позиция + 1;
    }
}

дело дж_читать_значение(текст: строка, позиция: указатель число) -> строка {
    дж_пропуск(текст, позиция);

    ежели по позиция >= длина(текст) {
        вернуть "";
    }

    слово знак: строка = часть(текст, по позиция, 1);

    ежели знак == "\"" {
        вернуть дж_читать_строку(текст, позиция);
    }

    ежели знак == "{" или знак == "[" {
        дж_пропустить_вложенное(текст, позиция);
        вернуть "";
    }

    слово начало: число = по позиция;

    доколе по позиция < длина(текст) {
        слово буква: строка = часть(текст, по позиция, 1);
        ежели буква == "," или буква == "}" или буква == "]" или
              буква == " " или буква == "\n" или буква == "\r" или буква == "\t" {
            прервать;
        }
        по позиция = по позиция + 1;
    }

    вернуть часть(текст, начало, по позиция - начало);
}

дело дж_разобрать(текст: строка) -> словарь {
    слово результат: словарь = создать_словарь();
    слово позиция: число = 0;

    дж_пропуск(текст, адрес позиция);

    ежели позиция >= длина(текст) или часть(текст, позиция, 1) != "{" {
        вернуть результат;
    }

    позиция = позиция + 1;

    доколе позиция < длина(текст) {
        дж_пропуск(текст, адрес позиция);

        ежели часть(текст, позиция, 1) == "}" {
            прервать;
        }

        слово ключ: строка = дж_читать_строку(текст, адрес позиция);
        дж_пропуск(текст, адрес позиция);

        ежели часть(текст, позиция, 1) == ":" {
            позиция = позиция + 1;
        }

        слово значение: строка = дж_читать_значение(текст, адрес позиция);
        положить(результат, ключ, значение);

        дж_пропуск(текст, адрес позиция);

        ежели часть(текст, позиция, 1) == "," {
            позиция = позиция + 1;
        }
    }

    вернуть результат;
}

дело дж_строка(текст: строка) -> строка {
    слово результат: строка = "\"";
    слово номер: число = 0;

    доколе номер < длина(текст) {
        слово знак: строка = часть(текст, номер, 1);

        ежели знак == "\"" {
            результат += "\\\"";
        } инако ежели знак == "\\" {
            результат += "\\\\";
        } инако ежели знак == "\n" {
            результат += "\\n";
        } инако ежели знак == "\t" {
            результат += "\\t";
        } инако ежели знак == "\r" {
            результат += "\\r";
        } инако {
            результат += знак;
        }

        номер += 1;
    }

    вернуть результат + "\"";
}

дело дж_из_словаря(данные: словарь) -> строка {
    слово результат: строка = "{";
    слово номер: число = 0;
    слово всего: число = размер(данные);

    доколе номер < всего {
        ежели номер > 0 {
            результат += ",";
        }
        результат += дж_строка(ключ_по_номеру(данные, номер));
        результат += ":";
        результат += дж_строка(значение_по_номеру(данные, номер));
        номер += 1;
    }

    вернуть результат + "}";
}

дело дж_массив_строк(значения: срез строка) -> строка {
    слово результат: строка = "[";
    слово первый: флаг = правда;

    для каждого значение из значения {
        ежели не первый {
            результат += ",";
        }
        результат += дж_строка(значение);
        первый = кривда;
    }

    вернуть результат + "]";
}
