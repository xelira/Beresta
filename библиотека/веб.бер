// Русская веб-библиотека. HTML-теги спрятаны внутри: в коде — только русские
// функции, а браузер получает обычный HTML.

дело экранировать(текст: строка) -> строка {
    слово результат: строка = "";
    слово номер: число = 0;

    доколе номер < длина(текст) {
        слово знак: строка = часть(текст, номер, 1);

        ежели знак == "&" {
            результат += "&amp;";
        } инако ежели знак == "<" {
            результат += "&lt;";
        } инако ежели знак == ">" {
            результат += "&gt;";
        } инако ежели знак == "\"" {
            результат += "&quot;";
        } инако {
            результат += знак;
        }

        номер += 1;
    }

    вернуть результат;
}

дело заголовок(текст: строка) -> строка {
    вернуть "<h1>" + экранировать(текст) + "</h1>";
}

дело подзаголовок(текст: строка) -> строка {
    вернуть "<h2>" + экранировать(текст) + "</h2>";
}

дело абзац(текст: строка) -> строка {
    вернуть "<p>" + экранировать(текст) + "</p>";
}

дело жирный(текст: строка) -> строка {
    вернуть "<strong>" + экранировать(текст) + "</strong>";
}

дело курсив(текст: строка) -> строка {
    вернуть "<em>" + экранировать(текст) + "</em>";
}

дело ссылка(куда: строка, текст: строка) -> строка {
    вернуть "<a href=\"" + экранировать(куда) + "\">" + экранировать(текст) + "</a>";
}

дело пункт(текст: строка) -> строка {
    вернуть "<li>" + экранировать(текст) + "</li>";
}

дело список(содержимое: строка) -> строка {
    вернуть "<ul>" + содержимое + "</ul>";
}

дело раздел(содержимое: строка) -> строка {
    вернуть "<div>" + содержимое + "</div>";
}

дело документ(имя: строка, тело: строка) -> строка {
    слово стиль: строка =
        "body{font-family:system-ui,sans-serif;max-width:46rem;margin:3rem auto;padding:0 1rem;line-height:1.6;background:#faf7f0;color:#242018}" +
        "h1{color:#3d5a2a}a{color:#3d5a2a}code{background:#eee8da;padding:.1rem .3rem;border-radius:.2rem}";

    вернуть "<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\">" +
           "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
           "<title>" + экранировать(имя) + "</title><style>" + стиль + "</style></head><body>" +
           тело + "</body></html>";
}

дело ответ(код: число, причина: строка, тело: строка) -> строка {
    вернуть "HTTP/1.1 " + к_строке(код) + " " + причина + "\r\n" +
           "Content-Type: text/html; charset=utf-8\r\n" +
           "Content-Length: " + к_строке(байты(тело)) + "\r\n" +
           "X-Content-Type-Options: nosniff\r\n" +
           "Connection: close\r\n\r\n" + тело;
}

дело ответ_дж(тело: строка) -> строка {
    вернуть "HTTP/1.1 200 OK\r\n" +
           "Content-Type: application/json; charset=utf-8\r\n" +
           "Content-Length: " + к_строке(байты(тело)) + "\r\n" +
           "X-Content-Type-Options: nosniff\r\n" +
           "Connection: close\r\n\r\n" + тело;
}

дело ответ_хорошо(тело: строка) -> строка {
    вернуть ответ(200, "OK", тело);
}

дело ответ_не_найдено() -> строка {
    вернуть ответ(404, "Not Found",
                  документ("Не найдено", заголовок("404") + абзац("Такой страницы нет.")));
}

дело путь(запрос: строка) -> строка {
    слово метка: число = найти(запрос, " ");
    ежели метка < 0 {
        вернуть "/";
    }

    слово хвост: строка = часть(запрос, метка + 1, 500);
    слово конец: число = найти(хвост, " ");
    ежели конец >= 0 {
        хвост = часть(хвост, 0, конец);
    }

    вернуть хвост;
}

дело параметр(запрос: строка, имя: строка) -> строка {
    слово метка: число = найти(запрос, имя + "=");
    ежели метка < 0 {
        вернуть "";
    }

    слово хвост: строка = часть(запрос, метка + длина(имя) + 1, 300);
    слово пробел: число = найти(хвост, " ");
    слово амперсанд: число = найти(хвост, "&");
    слово конец: число = пробел;

    ежели амперсанд >= 0 и (конец < 0 или амперсанд < конец) {
        конец = амперсанд;
    }
    ежели конец >= 0 {
        хвост = часть(хвост, 0, конец);
    }

    вернуть раскодировать_адрес(хвост);
}

дело обрезать(текст: строка) -> строка {
    слово начало: число = 0;

    доколе начало < длина(текст) {
        слово знак: строка = часть(текст, начало, 1);
        ежели знак == " " или знак == "\t" или знак == "\r" или знак == "\n" {
            начало += 1;
        } инако {
            прервать;
        }
    }

    слово конец: число = длина(текст);
    доколе конец > начало {
        слово знак: строка = часть(текст, конец - 1, 1);
        ежели знак == " " или знак == "\t" или знак == "\r" или знак == "\n" {
            конец -= 1;
        } инако {
            прервать;
        }
    }

    вернуть часть(текст, начало, конец - начало);
}

дело кончается(текст: строка, хвост: строка) -> флаг {
    ежели длина(хвост) > длина(текст) {
        вернуть кривда;
    }
    вернуть часть(текст, длина(текст) - длина(хвост), длина(хвост)) == хвост;
}

дело метод(запрос: строка) -> строка {
    слово метка: число = найти(запрос, " ");
    ежели метка < 0 {
        вернуть "";
    }
    вернуть часть(запрос, 0, метка);
}

дело заголовок_запроса(запрос: строка, имя: строка) -> строка {
    слово низ: строка = строчные(запрос);
    слово игла: строка = строчные(имя) + ":";
    слово метка: число = найти(низ, игла);

    ежели метка < 0 {
        вернуть "";
    }

    слово хвост: строка = часть(запрос, метка + длина(игла), 400);
    слово конец: число = найти(хвост, "\r\n");
    ежели конец < 0 {
        конец = найти(хвост, "\n");
    }
    ежели конец >= 0 {
        хвост = часть(хвост, 0, конец);
    }

    вернуть обрезать(хвост);
}

дело параметры(запрос: строка) -> словарь {
    слово итог: словарь = создать_словарь();
    слово метка: число = найти(запрос, "?");

    ежели метка < 0 {
        вернуть итог;
    }

    слово хвост: строка = часть(запрос, метка + 1, 600);
    слово конец: число = найти(хвост, " ");
    ежели конец >= 0 {
        хвост = часть(хвост, 0, конец);
    }

    доколе длина(хвост) > 0 {
        слово амперсанд: число = найти(хвост, "&");
        слово пара: строка = хвост;

        ежели амперсанд >= 0 {
            пара = часть(хвост, 0, амперсанд);
            хвост = часть(хвост, амперсанд + 1, 600);
        } инако {
            хвост = "";
        }

        слово равно: число = найти(пара, "=");
        ежели равно >= 0 {
            слово ключ: строка = часть(пара, 0, равно);
            слово значение: строка = часть(пара, равно + 1, 400);
            положить(итог, раскодировать_адрес(ключ), раскодировать_адрес(значение));
        }
    }

    вернуть итог;
}

дело куки(запрос: строка) -> словарь {
    слово итог: словарь = создать_словарь();
    слово остаток: строка = заголовок_запроса(запрос, "Cookie");

    доколе длина(остаток) > 0 {
        слово точка: число = найти(остаток, ";");
        слово пара: строка = остаток;

        ежели точка >= 0 {
            пара = часть(остаток, 0, точка);
            остаток = часть(остаток, точка + 1, 600);
        } инако {
            остаток = "";
        }

        слово равно: число = найти(пара, "=");
        ежели равно >= 0 {
            слово ключ: строка = обрезать(часть(пара, 0, равно));
            слово значение: строка = обрезать(часть(пара, равно + 1, 400));
            положить(итог, ключ, значение);
        }
    }

    вернуть итог;
}

дело ответ_с_типом(код: число, причина: строка, тип: строка, тело: строка) -> строка {
    вернуть "HTTP/1.1 " + к_строке(код) + " " + причина + "\r\n" +
           "Content-Type: " + тип + "\r\n" +
           "Content-Length: " + к_строке(байты(тело)) + "\r\n" +
           "X-Content-Type-Options: nosniff\r\n" +
           "Connection: close\r\n\r\n" + тело;
}

дело ответ_редирект(куда: строка) -> строка {
    вернуть "HTTP/1.1 302 Found\r\n" +
           "Location: " + куда + "\r\n" +
           "Content-Length: 0\r\n" +
           "Connection: close\r\n\r\n";
}

дело тип_файла(путь: строка) -> строка {
    ежели кончается(путь, ".html") {
        вернуть "text/html; charset=utf-8";
    } инако ежели кончается(путь, ".css") {
        вернуть "text/css; charset=utf-8";
    } инако ежели кончается(путь, ".js") {
        вернуть "application/javascript; charset=utf-8";
    } инако ежели кончается(путь, ".json") {
        вернуть "application/json; charset=utf-8";
    } инако ежели кончается(путь, ".svg") {
        вернуть "image/svg+xml";
    } инако ежели кончается(путь, ".png") {
        вернуть "image/png";
    } инако ежели кончается(путь, ".jpg") {
        вернуть "image/jpeg";
    }
    вернуть "application/octet-stream";
}

дело статика(путь: строка) -> строка {
    ежели содержит(путь, "..") {
        вернуть ответ(403, "Forbidden",
                      документ("Запрещено", заголовок("403") + абзац("Так нельзя.")));
    }

    ежели не есть_файл(путь) {
        вернуть ответ_не_найдено();
    }

    слово данные: строка = слушает(путь);
    вернуть ответ_с_типом(200, "OK", тип_файла(путь), данные);
}

дело вс_рукопожатие(запрос: строка) -> строка {
    слово ключ: строка = заголовок_запроса(запрос, "Sec-WebSocket-Key");
    ежели ключ == "" {
        вернуть "";
    }

    слово ответ_ключ: строка = отпечаток_б64(
        ключ + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11");

    вернуть "HTTP/1.1 101 Switching Protocols\r\n" +
           "Upgrade: websocket\r\n" +
           "Connection: Upgrade\r\n" +
           "Sec-WebSocket-Accept: " + ответ_ключ + "\r\n\r\n";
}

дело вс_опкод(кадр: строка) -> число {
    ежели байты(кадр) < 2 {
        вернуть 0;
    }
    вернуть байт(кадр, 0) % 16;
}

дело вс_текст_из_кадра(кадр: строка) -> строка {
    слово размер: число = байты(кадр);
    ежели размер < 2 {
        вернуть "";
    }

    слово второй: число = байт(кадр, 1);
    слово маска: флаг = второй >= 128;
    слово длина_кадра: число = второй % 128;
    слово смещение: число = 2;

    ежели длина_кадра == 126 {
        ежели размер < 4 {
            вернуть "";
        }
        длина_кадра = байт(кадр, 2) * 256 + байт(кадр, 3);
        смещение = 4;
    } инако ежели длина_кадра == 127 {
        вернуть "";
    }

    слово начало: число = смещение;
    ежели маска {
        начало += 4;
    }
    ежели начало + длина_кадра > размер {
        длина_кадра = размер - начало;
    }

    слово итог: строка = "";
    слово номер: число = 0;

    доколе номер < длина_кадра {
        слово значение: число = байт(кадр, начало + номер);
        ежели маска {
            значение = исключающее_или(значение, байт(кадр, смещение + (номер % 4)));
        }
        итог += из_байта(значение);
        номер += 1;
    }

    вернуть итог;
}

дело вс_кадр_из_текста(текст: строка) -> строка {
    слово размер: число = байты(текст);

    ежели размер < 126 {
        вернуть из_байта(129) + из_байта(размер) + текст;
    }

    ежели размер < 65536 {
        вернуть из_байта(129) + из_байта(126) +
               из_байта(размер / 256) + из_байта(размер % 256) + текст;
    }

    вернуть "";
}

дело вс_понг(текст: строка) -> строка {
    слово размер: число = байты(текст);
    ежели размер > 125 {
        размер = 0;
    }
    вернуть из_байта(138) + из_байта(размер) + часть(текст, 0, размер);
}

дело вс_закрыть() -> строка {
    вернуть из_байта(136) + из_байта(0);
}

дело разобрать_пары(текст: строка) -> словарь {
    слово итог: словарь = создать_словарь();
    слово остаток: строка = текст;

    доколе длина(остаток) > 0 {
        слово амперсанд: число = найти(остаток, "&");
        слово пара: строка = остаток;

        ежели амперсанд >= 0 {
            пара = часть(остаток, 0, амперсанд);
            остаток = часть(остаток, амперсанд + 1, 600);
        } инако {
            остаток = "";
        }

        слово равно: число = найти(пара, "=");
        ежели равно >= 0 {
            слово ключ: строка = часть(пара, 0, равно);
            слово значение: строка = часть(пара, равно + 1, 400);
            положить(итог, раскодировать_адрес(ключ), раскодировать_адрес(значение));
        }
    }

    вернуть итог;
}

дело тело(запрос: строка) -> строка {
    слово метка: число = найти(запрос, "\r\n\r\n");
    ежели метка < 0 {
        вернуть "";
    }
    вернуть часть(запрос, метка + 4, 10000);
}

дело форма(запрос: строка) -> словарь {
    вернуть разобрать_пары(тело(запрос));
}

дело список_из(элементы: срез строка) -> строка {
    слово внутри: строка = "";

    для каждого значение из элементы {
        внутри += пункт(значение);
    }

    вернуть список(внутри);
}

дело форма_ввода(куда: строка, поле: строка, кнопка: строка) -> строка {
    вернуть "<form method=\"post\" action=\"" + экранировать(куда) + "\">" +
           "<input name=\"" + экранировать(поле) + "\">" +
           "<button>" + экранировать(кнопка) + "</button></form>";
}

дело кука(имя: строка, значение: строка) -> строка {
    вернуть "Set-Cookie: " + имя + "=" + значение + "; Path=/; HttpOnly";
}

дело новый_ид() -> строка {
    вернуть к_строке(время()) + "-" + к_строке(жребий(1000000));
}

дело ответ_с_заголовками(код: число, причина: строка, тип: строка,
                         тело: строка, заголовки: строка) -> строка {
    слово ответ: строка = "HTTP/1.1 " + к_строке(код) + " " + причина + "\r\n" +
                            "Content-Type: " + тип + "\r\n" +
                            "Content-Length: " + к_строке(байты(тело)) + "\r\n" +
                            "X-Content-Type-Options: nosniff\r\n";

    ежели заголовки != "" {
        ответ += заголовки + "\r\n";
    }

    вернуть ответ + "Connection: close\r\n\r\n" + тело;
}
