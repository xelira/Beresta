// Указатели: адрес, разыменование, запись по адресу.

дело удвоить(п: указатель число) -> ничто {
    по п = по п * 2;
}

береста {
    слово х: число = 42;
    слово п: указатель число = адрес х;

    молви "по указателю: " + к_строке(по п);

    по п = 100;
    молви "х теперь: " + к_строке(х);

    удвоить(п);
    молви "после функции: " + к_строке(х);

    слово имена: [3]строка;
    имена[1] = "Боря";
    слово пи: указатель строка = адрес имена[1];
    по пи = "Борис";
    молви "элемент: " + имена[1];
}
