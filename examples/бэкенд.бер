// Бэкенд-обвязка: аргументы, среда, время, файлы, строки, URL.

береста {
    молви "аргументов: " + к_строке(доводы());
    слово номер: число = 0;
    доколе номер < доводы() {
        молви "  " + к_строке(номер) + ": " + довод(номер);
        номер += 1;
    }

    молви "HOME: " + среда("HOME");
    молви "время больше нуля: " + к_строке(время() > 0);
    сон(10);

    слово путь: строка = "пример_файла.txt";
    слово записано: флаг = пишет(путь, "привет, мир");
    молви "записано: " + к_строке(записано) +
          ", размер: " + к_строке(размер_файла(путь));

    слово текст: строка = слушает(путь);
    молви "часть: " + часть(текст, 7, 3);
    молви "найти «мир»: " + к_строке(найти(текст, "мир"));

    слово код: строка = кодировать_адрес("привет мир&x=1");
    молви "url: " + код;
    молви "обратно: " + раскодировать_адрес(код);

    молви "удалено: " + к_строке(удалить_файл(путь));
}
