// WebSocket-эхо: рукопожатие, кадры, ответ на ping.

привлечь "../библиотека/веб.бер";

береста {
    слово сервер: число = слушать(8097);

    ежели сервер < 0 {
        молви "не удалось открыть порт";
    } инако {
        молви "websocket: ws://localhost:8097";

        доколе правда {
            слово клиент: число = принять(сервер);
            ежели клиент < 0 {
                продолжить;
            }

            слово запрос: строка = прочитать(клиент, 8192);

            ежели содержит(строчные(запрос), "upgrade: websocket") {
                ответить(клиент, вс_рукопожатие(запрос));

                слово работаем: флаг = правда;
                доколе работаем {
                    слово кадр: строка = прочитать(клиент, 8192);
                    ежели байты(кадр) < 2 {
                        прервать;
                    }

                    слово код: число = вс_опкод(кадр);

                    ежели код == 8 {
                        ответить(клиент, вс_закрыть());
                        прервать;
                    } инако ежели код == 9 {
                        ответить(клиент, вс_понг(вс_текст_из_кадра(кадр)));
                        продолжить;
                    } инако ежели код == 1 {
                        слово текст: строка = вс_текст_из_кадра(кадр);
                        ответить(клиент, вс_кадр_из_текста("эхо: " + текст));
                    }
                }
            } инако {
                ответить(клиент, ответ(200, "OK",
                    документ("WebSocket", заголовок("WebSocket") +
                             абзац("Подключитесь к ws://localhost:8097"))));
            }

            закрыть(клиент);
        }
    }
}
