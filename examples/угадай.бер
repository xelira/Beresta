// Угадайка: ввод с клавиатуры, цикл, ветвления.

устой СЕКРЕТ: число = 42;

береста {
    молви "Я загадала число от 1 до 100.";
    слово попыток: число = 0;

    доколе правда {
        молви "Твой вариант:";
        слово ввод: строка = внемли();

        ежели длина(ввод) == 0 {
            молви "Пустой ввод. Выхожу.";
            прервать;
        }

        слово ответ: число = из_строки(ввод);
        попыток = попыток + 1;

        ежели ответ < СЕКРЕТ {
            молви "Больше.";
        } инако ежели ответ > СЕКРЕТ {
            молви "Меньше.";
        } инако {
            молви "Угадал! Попыток: " + к_строке(попыток);
            прервать;
        }
    }
}
