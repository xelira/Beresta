// JSON: сборка из словаря и разбор плоского объекта.

привлечь "../библиотека/json.бер";

береста {
    слово данные: словарь = создать_словарь();
    положить(данные, "язык", "береста");
    положить(данные, "потужно", "правда");
    положить(данные, "число", "42");

    слово текст: строка = дж_из_словаря(данные);
    молви текст;

    слово разобранные: словарь = дж_разобрать(
        "{\"имя\":\"Аня\",\"город\":\"Москва\",\"n\":7}");

    молви "имя: " + взять(разобранные, "имя");
    молви "город: " + взять(разобранные, "город");
    молви "n: " + взять(разобранные, "n");
    молви "пар: " + к_строке(размер(разобранные));

    слово буквы: [3]строка;
    буквы[0] = "а";
    буквы[1] = "б";
    буквы[2] = "в";
    слово окно: срез строка = нарезать(буквы, 0, 3);
    молви дж_массив_строк(окно);
}
