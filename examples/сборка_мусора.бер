// Сборка мусора: много временных строк, живая память остаётся маленькой.

береста {
    слово последняя: строка = "";

    повтор номер от 1 до 5000 {
        последняя = "мусор " + к_строке(номер);
    }

    молви "последняя: " + последняя;

    собрать();
    молви "живых байт после сборки: " + к_строке(память());
}
