// Уклады: свои типы, собранные из полей.

уклад Точка {
    х: дробь;
    у: дробь;
    имя: строка;
}

дело квадрат_расстояния(х: дробь, у: дробь) -> дробь {
    вернуть х * х + у * у;
}

береста {
    слово т: Точка;
    т.х = 3.0;
    т.у = 4.0;
    т.имя = "вершина";

    молви "точка: " + т.имя;
    молви "х = " + к_строке(т.х) + ", у = " + к_строке(т.у);
    молви "квадрат расстояния: " + к_строке(квадрат_расстояния(т.х, т.у));
}
