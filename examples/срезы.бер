// Срезы: вид на часть массива, без копирования.

дело сумма(с: срез число) -> число {
    слово итог: число = 0;
    для каждого значение из с {
        итог += значение;
    }
    вернуть итог;
}

береста {
    слово числа: [5]число;
    повтор номер от 0 до 4 {
        числа[номер] = номер * 10;
    }

    слово окно: срез число = нарезать(числа, 1, 4);

    молви "длина среза: " + к_строке(длина(окно));
    молви "первый элемент: " + к_строке(окно[0]);

    окно[0] = 99;
    молви "массив изменился: " + к_строке(числа[1]);

    молви "сумма среза: " + к_строке(сумма(окно));

    слово указатель_на_элемент: указатель число = адрес окно[1];
    по указатель_на_элемент = 7;
    молви "после указателя: " + к_строке(числа[2]);
}
