// Классическая таблица, но по-берестовски.

береста {
    повтор i от 1 до 15 {
        ежели i % 15 == 0 {
            молви "береста";
        } инако ежели i % 3 == 0 {
            молви "берёза";
        } инако ежели i % 5 == 0 {
            молви "кора";
        } инако {
            молви к_строке(i);
        }
    }
}
