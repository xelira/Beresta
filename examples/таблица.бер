// Классическая таблица, но по-берестовски.

береста {
    повтор номер от 1 до 15 {
        ежели номер % 15 == 0 {
            молви "береста";
        } инако ежели номер % 3 == 0 {
            молви "берёза";
        } инако ежели номер % 5 == 0 {
            молви "кора";
        } инако {
            молви к_строке(номер);
        }
    }
}
