// Разбор HTTP-запроса: метод, заголовки, параметры, куки.

привлечь "../библиотека/веб.бер";

береста {
    слово запрос: строка =
        "GET /api?имя=Аня&x=1 HTTP/1.1\r\n" +
        "Host: localhost\r\n" +
        "Cookie: сессия=abc; тема=тёмная\r\n" +
        "\r\n";

    молви "метод: " + метод(запрос);
    молви "хост: " + заголовок_запроса(запрос, "Host");

    слово параметры_запроса: словарь = параметры(запрос);
    молви "имя: " + взять(параметры_запроса, "имя");
    молви "x: " + взять(параметры_запроса, "x");

    слово печеньки: словарь = куки(запрос);
    молви "сессия: " + взять(печеньки, "сессия");
    молви "тема: " + взять(печеньки, "тема");

    молви "тип html: " + тип_файла("страница.html");
    молви "тип json: " + тип_файла("данные.json");
}
