// Дроби: смешанная арифметика число/дробь и константы.

устой ОБРАТНЫЙ_ПИ: дробь = 0.3183098861837907;

береста {
    слово сумма: дробь = 0.0;

    повтор номер от 1 до 10 {
        сумма = сумма + 1.0 / номер;
    }

    молви "Гармоническая сумма 1..10: " + к_строке(сумма);
    молви "1/ПИ: " + к_строке(ОБРАТНЫЙ_ПИ);
    молви "ПИ примерно: " + к_строке(1.0 / ОБРАТНЫЙ_ПИ);
    молви "целая часть: " + к_строке(7 / 2);
    молви "дробная часть: " + к_строке(7.0 / 2.0);
}
