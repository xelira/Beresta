// HTTP-клиент: GET по кудау из аргумента или по умолчанию.

береста {
    слово куда: строка = довод(1);
    ежели куда == "" {
        куда = "http://example.com/";
    }

    слово ответ: строка = запрос_сети(куда);

    ежели длина(ответ) == 0 {
        молви "не удалось получить ответ";
    } инако {
        молви "получено байт: " + к_строке(байты(ответ));
        молви часть(ответ, 0, 400);
    }
}
