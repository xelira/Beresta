// HTTPS: TLS-сервер на бересте.

привлечь "../библиотека/веб.бер";

береста {
    слово сервер: число = тлс_сервер(8443, "сертификат.pem", "ключ.pem");

    ежели сервер < 0 {
        молви "нужны сертификат.pem и ключ.pem рядом с программой";
    } инако {
        молви "https://localhost:8443";

        доколе правда {
            слово клиент: число = тлс_принять(сервер);
            ежели клиент < 0 {
                продолжить;
            }

            слово запрос: строка = тлс_прочитать(клиент, 8192);
            слово путь_страницы: строка = раскодировать_адрес(путь(запрос));

            слово тело: строка = документ("HTTPS",
                заголовок("Защищённый береста-сайт") +
                абзац("TLS работает, сертификат принят."));

            тлс_ответить(клиент, ответ(200, "OK", тело));
            тлс_закрыть(клиент);

            молви "200 " + путь_страницы;
            сбросить();
        }
    }
}
