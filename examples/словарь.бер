// Словари: строковые ключи и значения, обход по номеру.

береста {
    слово человек: словарь = создать_словарь();

    положить(человек, "имя", "Аня");
    положить(человек, "город", "Москва");
    положить(человек, "язык", "береста");

    молви "имя: " + взять(человек, "имя");
    молви "размер: " + к_строке(размер(человек));

    положить(человек, "имя", "Боря");
    молви "новое имя: " + взять(человек, "имя");

    слово номер: число = 0;
    доколе номер < размер(человек) {
        молви ключ_по_номеру(человек, номер) + " = " +
              значение_по_номеру(человек, номер);
        номер += 1;
    }

    молви "город есть: " + к_строке(есть_ключ(человек, "город"));
    молви "удалён: " + к_строке(удалить_ключ(человек, "город"));
    молви "осталось: " + к_строке(размер(человек));
}
