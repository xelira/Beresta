// Настоящий сайт на бересте: HTTP-сервер на сокетах.

береста {
    слово сервер: число = слушать(8099);

    ежели сервер < 0 {
        молви "не удалось открыть порт 8099";
    } инако {
        молви "сайт: http://localhost:8099";

        доколе правда {
            слово клиент: число = принять(сервер);
            ежели клиент < 0 {
                продолжить;
            }

            слово запрос: строка = прочитать(клиент, 8192);
            слово страница: строка =
                "<h1>Береста</h1><p>Потужно.</p>";

            ежели содержит(запрос, "GET /about") {
                страница = "<h1>О языке</h1><p>Свои указатели, своя память.</p>";
            }

            ответить(клиент,
                     "HTTP/1.1 200 OK\r\n" +
                     "Content-Type: text/html; charset=utf-8\r\n" +
                     "Connection: close\r\n\r\n" +
                     страница);
            закрыть(клиент);
        }
    }
}
