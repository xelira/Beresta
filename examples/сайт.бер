// Сайт на бересте: всё на русском, HTML спрятан в библиотеке.

привлечь "../библиотека/веб.бер";
привлечь "../библиотека/json.бер";

береста {
    слово порт: число = из_строки(среда("PORT"));
    ежели порт <= 0 {
        порт = 8099;
    }

    слово сервер: число = слушать(порт);

    ежели сервер < 0 {
        молви "не удалось открыть порт " + к_строке(порт);
    } инако {
        слово сессии: словарь = создать_словарь();
        молви "сайт: http://localhost:" + к_строке(порт);

        доколе правда {
            слово клиент: число = принять(сервер);
            ежели клиент < 0 {
                продолжить;
            }

            слово запрос: строка = прочитать(клиент, 8192);
            слово путь_страницы: строка = раскодировать_адрес(путь(запрос));

            слово код: число = 200;
            слово причина: строка = "OK";
            слово тело: строка = "";
            слово это_дж: флаг = кривда;
            слово доп_заголовки: строка = "";

            ежели путь_страницы == "/" {
                тело = документ("Береста",
                                заголовок("Береста") +
                                абзац("Потужно и качественно.") +
                                абзац("Этот сайт собран компилятором бересты."));
            } инако ежели путь_страницы == "/о" {
                тело = документ("О языке",
                                заголовок("О языке") +
                                абзац("Свои указатели, своя память, свои сокеты.") +
                                абзац("HTML-теги живут в библиотеке, а не в коде."));
            } инако ежели путь_страницы == "/счёт" {
                слово печеньки: словарь = куки(запрос);
                слово ид: строка = взять(печеньки, "session");
                слово новая: флаг = кривда;

                ежели ид == "" {
                    ид = новый_ид();
                    новая = правда;
                }

                слово значение: число = из_строки(взять(сессии, ид)) + 1;
                положить(сессии, ид, к_строке(значение));

                тело = документ("Счёт",
                                заголовок("Счёт: " + к_строке(значение)) +
                                абзац("Обновите страницу — число вырастет."));

                ежели новая {
                    доп_заголовки = кука("session", ид);
                }
            } инако ежели путь_страницы == "/форма" {
                ежели метод(запрос) == "POST" {
                    слово данные: словарь = форма(запрос);
                    слово имя: строка = взять(данные, "имя");
                    ежели имя == "" {
                        имя = "мир";
                    }
                    тело = документ("Форма",
                                    заголовок("Привет, " + имя + "!") +
                                    ссылка("/форма", "Ещё раз"));
                } инако {
                    тело = документ("Форма",
                                    заголовок("Как тебя зовут?") +
                                    форма_ввода("/форма", "имя", "Отправить"));
                }
            } инако ежели начинается(путь_страницы, "/api") {
                слово параметры_запроса: словарь = параметры(запрос);
                тело = дж_из_словаря(параметры_запроса);
                это_дж = правда;
            } инако ежели начинается(путь_страницы, "/куки") {
                слово печеньки: словарь = куки(запрос);
                тело = дж_из_словаря(печеньки);
                это_дж = правда;
            } инако ежели путь_страницы == "/json" {
                слово данные: словарь = создать_словарь();
                положить(данные, "язык", "береста");
                положить(данные, "потужно", "правда");
                положить(данные, "время", к_строке(время()));
                тело = дж_из_словаря(данные);
                это_дж = правда;
            } инако ежели путь_страницы == "/время" {
                тело = документ("Время",
                                заголовок("Время") +
                                абзац("Сейчас: " + к_строке(время())));
            } инако ежели начинается(путь_страницы, "/привет") {
                слово имя: строка = параметр(путь_страницы, "имя");
                ежели имя == "" {
                    имя = "мир";
                }
                тело = документ("Привет",
                                заголовок("Привет, " + имя + "!") +
                                абзац("Параметр пришёл из адресной строки."));
            } инако {
                код = 404;
                причина = "Not Found";
                тело = документ("Не найдено",
                                заголовок("404") +
                                абзац("Такой страницы нет."));
            }

            ежели это_дж {
                ответить(клиент, ответ_дж(тело));
            } инако {
                ответить(клиент, ответ_с_заголовками(код, причина,
                                                     "text/html; charset=utf-8",
                                                     тело, доп_заголовки));
            }
            закрыть(клиент);

            молви к_строке(код) + "  " + путь_страницы;
            сбросить();
        }
    }
}
