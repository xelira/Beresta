// Настоящий сайт на бересте: маршруты, параметры, время, логи.

береста {
    слово порт: число = из_строки(среда("PORT"));
    ежели порт <= 0 {
        порт = 8099;
    }

    слово сервер: число = слушать(порт);

    ежели сервер < 0 {
        молви "не удалось открыть порт " + к_строке(порт);
    } инако {
        молви "сайт: http://localhost:" + к_строке(порт);

        доколе правда {
            слово клиент: число = принять(сервер);
            ежели клиент < 0 {
                продолжить;
            }

            слово запрос: строка = прочитать(клиент, 8192);
            слово страница: строка = "<h1>Береста</h1><p>Потужно.</p>";
            слово код: число = 200;
            слово причина: строка = "OK";

            ежели содержит(запрос, "GET /about") {
                страница = "<h1>О языке</h1><p>Свои указатели, своя память.</p>";
            } инако ежели содержит(запрос, "GET /time") {
                страница = "<h1>Время</h1><p>" + к_строке(время()) + "</p>";
            } инако ежели содержит(запрос, "GET /hello") {
                слово имя: строка = "мир";
                слово метка: число = найти(запрос, "name=");
                ежели метка >= 0 {
                    слово хвост: строка = часть(запрос, метка + 5, 40);
                    слово конец: число = найти(хвост, " ");
                    ежели конец >= 0 {
                        хвост = часть(хвост, 0, конец);
                    }
                    имя = раскодировать_адрес(хвост);
                }
                страница = "<h1>Привет, " + имя + "!</h1>";
            } инако ежели не начинается(запрос, "GET ") {
                код = 405;
                причина = "Method Not Allowed";
                страница = "<h1>Только GET</h1>";
            }

            ответить(клиент,
                     "HTTP/1.1 " + к_строке(код) + " " + причина + "\r\n" +
                     "Content-Type: text/html; charset=utf-8\r\n" +
                     "Connection: close\r\n\r\n" +
                     страница);
            закрыть(клиент);

            молви к_строке(код) + "  " + к_строке(длина(запрос)) + " байт";
            сбросить();
        }
    }
}
