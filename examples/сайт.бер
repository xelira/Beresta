// Сайт на бересте: всё на русском, HTML спрятан в библиотеке.

привлечь "../библиотека/веб.бер";

береста {
    слово порт: число = из_строки(среда("PORT"));
    ежели порт <= 0 {
        порт = 8099;
    }

    слово сервер: число = слушать(порт);

    ежели сервер < 0 {
        молви "не удалось открыть порт " + к_строке(порт);
    } инако {
        молви "сайт: http://localhost:" + к_строке(порт);

        доколе правда {
            слово клиент: число = принять(сервер);
            ежели клиент < 0 {
                продолжить;
            }

            слово запрос: строка = прочитать(клиент, 8192);
            слово путь_страницы: строка = раскодировать_адрес(путь(запрос));

            слово код: число = 200;
            слово причина: строка = "OK";
            слово тело: строка = "";

            ежели путь_страницы == "/" {
                тело = документ("Береста",
                                заголовок("Береста") +
                                абзац("Потужно и качественно.") +
                                абзац("Этот сайт собран компилятором бересты."));
            } инако ежели путь_страницы == "/о" {
                тело = документ("О языке",
                                заголовок("О языке") +
                                абзац("Свои указатели, своя память, свои сокеты.") +
                                абзац("HTML-теги живут в библиотеке, а не в коде."));
            } инако ежели путь_страницы == "/время" {
                тело = документ("Время",
                                заголовок("Время") +
                                абзац("Сейчас: " + к_строке(время())));
            } инако ежели начинается(путь_страницы, "/привет") {
                слово имя: строка = параметр(путь_страницы, "имя");
                ежели имя == "" {
                    имя = "мир";
                }
                тело = документ("Привет",
                                заголовок("Привет, " + имя + "!") +
                                абзац("Параметр пришёл из адресной строки."));
            } инако {
                код = 404;
                причина = "Not Found";
                тело = документ("Не найдено",
                                заголовок("404") +
                                абзац("Такой страницы нет."));
            }

            ответить(клиент, ответ(код, причина, тело));
            закрыть(клиент);

            молви к_строке(код) + "  " + путь_страницы;
            сбросить();
        }
    }
}
