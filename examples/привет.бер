// Первая береста: приветствие и немного арифметики.

дело приветствие(имя: строка) -> ничто {
    молви "Здравствуй, " + имя + "!";
}

береста {
    приветствие("мир");

    слово сумма: число = 0;
    повтор i от 1 до 5 {
        сумма = сумма + i * i;
    }

    молви "Сумма квадратов от 1 до 5: " + к_строке(сумма);
}
