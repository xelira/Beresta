// Массивы и уклады в параметрах функций: передаются по ссылке.

уклад Точка {
    х: дробь;
    у: дробь;
}

дело сумма_массива(а: [5]число) -> число {
    слово итог: число = 0;
    для каждого значение из а {
        итог += значение;
    }
    вернуть итог;
}

дело сдвинуть(т: Точка) -> ничто {
    т.х = т.х + 1.0;
    т.у = т.у + 1.0;
}

береста {
    слово числа: [5]число;
    повтор номер от 0 до 4 {
        числа[номер] = номер + 1;
    }
    молви "сумма: " + к_строке(сумма_массива(числа));

    слово т: Точка;
    т.х = 1.0;
    т.у = 2.0;
    сдвинуть(т);
    молви "после сдвига: " + к_строке(т.х) + ", " + к_строке(т.у);
}
