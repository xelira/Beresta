уклад Цвет {
    р: число;
    г: число;
    с: число;
}

уклад Точка {
    х: дробь;
    у: дробь;
    цвет: Цвет;
    имя: строка;
}

дело покрасить(т: Точка) -> ничто {
    т.цвет.г = 77;
}

дело затемнить(ц: указатель Цвет) -> ничто {
    ц.р = 5;
}

береста {
    слово т: Точка;
    т.х = 1.5;
    т.у = 2.5;
    т.цвет.р = 10;
    т.цвет.г = 20;
    т.цвет.с = 30;
    т.имя = "вершина";

    молви "цвет: " + к_строке(т.цвет.р) + "," + к_строке(т.цвет.г) + "," + к_строке(т.цвет.с);

    слово пц: указатель Цвет = адрес т.цвет;
    пц.р = 99;
    молви "р: " + к_строке(т.цвет.р);

    покрасить(т);
    молви "г: " + к_строке(т.цвет.г);

    затемнить(адрес т.цвет);
    молви "р после: " + к_строке(т.цвет.р);

    слово пт: указатель Точка = адрес т;
    молви "через указатель: " + к_строке(пт.цвет.с);
}
