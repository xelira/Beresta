// Массивы, «для каждого» и составное присваивание.

береста {
    слово кубы: [10]число;

    повтор i от 0 до 9 {
        кубы[i] = i * i * i;
    }

    слово итог: число = 0;
    для каждого куб из кубы {
        итог += куб;
    }

    молви "длина массива: " + к_строке(длина(кубы));
    молви "сумма кубов 0..9: " + к_строке(итог);
    молви "куб пятёрки: " + к_строке(кубы[5]);
}
